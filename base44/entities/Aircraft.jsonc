{
  "name": "Aircraft",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "variant": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ],
      "enumColors": [
        "green",
        "gray"
      ],
      "default": "ativo"
    },
    "rfmDocument": {
      "type": "string"
    },
    "rfmRevision": {
      "type": "string"
    },
    "maxGrossWeightKg": {
      "type": "number"
    },
    "maxGroundWeightKg": {
      "type": "number"
    },
    "minFlyingWeightKg": {
      "type": "number"
    },
    "maxOperatingAltitudeFt": {
      "type": "number"
    },
    "maxSeaLevelTempC": {
      "type": "number"
    },
    "minTempC": {
      "type": "number"
    },
    "emptyWeightKg": {
      "type": "number"
    },
    "seats": {
      "type": "number"
    },
    "fuelDensityKgL": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "slug",
    "model"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
