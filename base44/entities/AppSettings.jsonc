{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "units": {
      "type": "string",
      "enum": [
        "metric",
        "imperial"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "metric"
    },
    "qnhUnit": {
      "type": "string",
      "enum": [
        "hPa",
        "inHg"
      ],
      "enumColors": [
        "blue",
        "purple"
      ],
      "default": "hPa"
    },
    "defaultSafetyMarginKg": {
      "type": "number",
      "default": 0
    }
  },
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
