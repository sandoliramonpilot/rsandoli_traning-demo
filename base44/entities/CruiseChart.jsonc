{
  "name": "CruiseChart",
  "type": "object",
  "properties": {
    "aircraftId": {
      "type": "string"
    },
    "pressureAltitudeFt": {
      "type": "number"
    },
    "oatC": {
      "type": "number"
    },
    "sourceFigure": {
      "type": "string"
    },
    "sourceRevision": {
      "type": "string"
    },
    "data": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "validado"
      ],
      "enumColors": [
        "yellow",
        "green"
      ],
      "default": "pendente"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "aircraftId",
    "sourceFigure",
    "sourceRevision",
    "data"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
